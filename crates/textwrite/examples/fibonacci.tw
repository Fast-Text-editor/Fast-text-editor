# Recursion and higher-order functions.
fn fib(n) {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

for i in range(10) {
    print "fib({i}) = {fib(i)}"
}

# First-class functions and higher-order builtins.
let numbers = range(1, 6)
let doubled = map(numbers, fn(x) { return x * 2 })
let evens = filter(numbers, fn(x) { return x % 2 is 0 })
let total = reduce(numbers, fn(acc, x) { return acc + x }, 0)

print "doubled:", doubled
print "evens:  ", evens
print "total:  ", total
